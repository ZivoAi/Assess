# Server
  PORT=3000
  NODE_ENV=development

  # Redis (Railway Redis)
  REDIS_URL=redis://default:password@host:6379

  # OpenAI
  OPENAI_API_KEY=sk-...

  # CORS — comma-separated list of allowed origins (no wildcards in production)
  ALLOWED_ORIGINS=https://your-app.com,https://www.your-app.com

  # zivopal-core integration
  ZIVOPAL_CORE_URL=https://zivopal-core.up.railway.app
  ZIVOPAL_SERVICE_KEY=shared-secret-between-core-and-assess
  
# PostgreSQL — set the same URL and schema on the API and worker.
DATABASE_URL=postgresql://user:password@host:5432/database
# Use assess when sharing Railway Postgres with zivopal-core.
ASSESS_DB_SCHEMA=public

# Set to worker on the separate Railway worker process.
ASSESS_PROCESS=api
